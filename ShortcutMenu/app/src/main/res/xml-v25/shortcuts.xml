<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="settings_shortcut"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_manage"
        android:shortcutShortLabel="@string/shortcut_short_label"
        android:shortcutLongLabel="@string/shortcut_long_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.br.shortcutmenu"
            android:targetClass="com.br.shortcutmenu.SettingsActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="fixing_navigation_settings_shortcut"
        android:enabled="true"
        android:shortcutShortLabel="@string/fixing_navigation_shortcut_short_label"
        android:shortcutLongLabel="@string/fixing_navigation_shortcut_long_label"
        android:icon="@android:drawable/ic_menu_manage">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.br.shortcutmenu"
            android:targetClass="com.br.shortcutmenu.FixingSettingsNavigationActivity" />
    </shortcut>
</shortcuts>